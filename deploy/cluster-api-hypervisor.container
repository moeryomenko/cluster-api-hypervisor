# cluster-api-hypervisor user quadlet.
#
# This unit runs only the provider manager. The HostAgent is a separately
# deployed, authenticated host-lifecycle service; do not add host KVM,
# Cloud Hypervisor, k8netd, artifact, or state mounts here.
#
# CAPISHIM_STATE_ROOT defaults to ~/.local/share/capishim. It supplies the
# webhook certificate, management kubeconfig, and the read-only HostAgent mTLS
# materials. The agent client certificate and CA must be provisioned by the
# installation; this unit never creates or exposes their contents.
#
# Build the image first: make image  (-> localhost/cluster-api-hypervisor:dev)
# Install: make install-quadlet, then
#   systemctl --user daemon-reload && systemctl --user start \
#       cluster-api-hypervisor.service

[Unit]
Description=cluster-api-hypervisor provider manager (rootless podman quadlet)
Wants=network-online.target capishim-pod.service
After=network-online.target capishim-pod.service
Requires=capishim-pod.service
StartLimitIntervalSec=0
StartLimitBurst=0

[Container]
Image=localhost/cluster-api-hypervisor:dev
Network=host
# Webhook serving certificate/key provisioned by capishim.
Mount=type=bind,source=%h/.local/share/capishim/webhook-certs/hypervisor,target=/tmp/k8s-webhook-server/serving-certs,ro
# Management apiserver kubeconfig issued by capishim.
Mount=type=bind,source=%h/.local/share/capishim/kubeconfigs/hypervisor.kubeconfig,target=/etc/kubernetes/mgmt/hypervisor.kubeconfig,ro
# Read-only manager mTLS identity and HostAgent trust root.
Mount=type=bind,source=%h/.local/share/capishim/agent-client,target=/tls/agent-client,ro
Mount=type=bind,source=%h/.local/share/capishim/agent-ca/ca.crt,target=/tls/agent-ca/ca.crt,ro

# One Exec= directive: podman 6.x treats repeated directives as last-wins.
Exec=--kubeconfig=/etc/kubernetes/mgmt/hypervisor.kubeconfig --webhook-cert-dir=/tmp/k8s-webhook-server/serving-certs --webhook-port=9443 --health-addr=:9440 --hypervisorcluster-concurrency=1 --hypervisormachine-concurrency=1 --hypervisorconfig-concurrency=1 --hypervisorcontrolplane-concurrency=1 --agent-address=127.0.0.1:9444 --agent-server-name=hypervisor-agent --agent-client-cert-dir=/tls/agent-client --agent-ca=/tls/agent-ca/ca.crt

[Service]
Restart=always
