# cluster-api-hypervisor.quadlet — provider manager only.
#
# apply.sh replaces /var/lib/k8slab/mgmt with MGMT_STATE_DIR. Host lifecycle is
# delegated to the separately provisioned HostAgent at the configured mTLS
# endpoint; this manager unit must not gain direct host-lifecycle access.

[Unit]
Description=cluster-api-hypervisor provider manager quadlet
After=network-online.target mgmt-kube-apiserver.service mgmt-hypervisor-agent.service
Wants=network-online.target
Requires=mgmt-kube-apiserver.service mgmt-hypervisor-agent.service

[Container]
Image=localhost/cluster-api-hypervisor:dev
Network=host
# Webhook serving certificate and key.
Mount=type=bind,source=/var/lib/k8slab/mgmt/webhook-certs,target=/tmp/k8s-webhook-server/serving-certs,ro
# Management apiserver kubeconfig.
Mount=type=bind,source=/var/lib/k8slab/mgmt/kubeconfigs/cluster-api-hypervisor.conf,target=/etc/kubernetes/mgmt/kubeconfigs/cluster-api-hypervisor.conf,ro
# HostAgent mTLS client identity and CA generated by pki.sh, read-only here.
Mount=type=bind,source=/var/lib/k8slab/mgmt/agent-client,target=/tls/agent-client,ro
Mount=type=bind,source=/var/lib/k8slab/mgmt/agent-ca/ca.crt,target=/tls/agent-ca/ca.crt,ro

Exec=--kubeconfig=/etc/kubernetes/mgmt/kubeconfigs/cluster-api-hypervisor.conf --webhook-cert-dir=/tmp/k8s-webhook-server/serving-certs --webhook-port=9443 --health-addr=:9440 --hypervisorcluster-concurrency=1 --hypervisormachine-concurrency=1 --hypervisorconfig-concurrency=1 --hypervisorcontrolplane-concurrency=1 --agent-address=127.0.0.1:9444 --agent-server-name=hypervisor-agent --agent-client-cert-dir=/tls/agent-client --agent-ca=/tls/agent-ca/ca.crt

[Service]
Restart=always
