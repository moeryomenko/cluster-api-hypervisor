FROM golang:1.26-alpine@sha256:1a9c10cf505a9e6b1e96ea77ebdbfe79a0f10380181faf88bc3b51d7e4315fae AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/hypervisor-agent ./cmd/agent

FROM alpine:edge@sha256:266f29255458134745f2bf588cb23ed1ed1768b96ff2580a05d70a8aba59e145

ARG CLOUD_HYPERVISOR_VERSION=48.0-r0
ARG QEMU_IMG_VERSION=11.1.1-r0
ARG SQUASHFS_TOOLS_VERSION=4.7.5-r0
ARG DOSFSTOOLS_VERSION=4.2-r2
ARG MTOOLS_VERSION=4.0.49-r0

RUN apk add --no-cache \
    --repository https://dl-cdn.alpinelinux.org/alpine/edge/testing \
    cloud-hypervisor=${CLOUD_HYPERVISOR_VERSION} \
    qemu-img=${QEMU_IMG_VERSION} \
    squashfs-tools=${SQUASHFS_TOOLS_VERSION} \
    dosfstools=${DOSFSTOOLS_VERSION} \
    mtools=${MTOOLS_VERSION} \
    dbus

COPY --from=builder /out/hypervisor-agent /usr/local/bin/hypervisor-agent
ENTRYPOINT ["/usr/local/bin/hypervisor-agent"]
